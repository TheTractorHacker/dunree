# LEGACY unit: for an install that was upgraded in place from Zoraxy and keeps its old names   (rebrand:keep)
# (unit zoraxy.service, program file zoraxy, folder /opt/zoraxy). New installs use dunree.service
# in this folder. Dunree never renames a unit by itself; renaming is optional and done with
# tools/install/migrate-from-zoraxy.sh (docs/migrating-from-zoraxy.md).
#
# Use this file to move such an install to Type=notify without renaming anything:
# copy it to /etc/systemd/system/zoraxy.service, adjust the two lines marked CHANGE, then:
#   sudo systemctl daemon-reload && sudo systemctl restart zoraxy
# See docs/deploy/README.md for what each line is for. Never enable this unit and dunree.service
# together: they would fight for the same ports and database.

[Unit]
Description=Dunree reverse proxy and web gateway
# The network must be up before Dunree binds addresses and talks to ACME / upstreams.
After=network-online.target
Wants=network-online.target
# Do not give up restarting after a few quick failures (a held port or database often clears on its own).
# (This key belongs in [Unit]; in [Service] systemd ignores it.)
StartLimitIntervalSec=0

[Service]
# Dunree tells systemd when it is really listening (admin port and proxy ports bound).
# Until then "systemctl status" shows "activating (start)" instead of a misleading "active".
Type=notify
# Needed so only Dunree itself (not its plugin children) may send readiness messages. This is the
# default for Type=notify, spelled out so nobody changes it by accident.
NotifyAccess=main

# CHANGE: the folder that holds the zoraxy binary, ./conf, ./sys.db, ./plugins ...
WorkingDirectory=/opt/zoraxy
# CHANGE: the binary and your usual flags (see ./zoraxy -h). Keep -port as you have it today.
ExecStart=/opt/zoraxy/zoraxy -port=:8000

# A start that has not reported READY within 2 minutes (for example blocked on a locked database)
# is killed and shown as "failed", instead of sitting "active" and silent forever.
TimeoutStartSec=120
# Time Dunree gets to shut down cleanly after SIGTERM (it drains requests and saves statistics;
# worst case 28 s) before SIGKILL.
TimeoutStopSec=30

# Restart after a crash or a failed start, but not after a deliberate "systemctl stop".
Restart=on-failure
RestartSec=5

# Stop the whole control group: Dunree AND every plugin process it started. Without this a plugin
# could outlive Dunree and keep a port or file busy.
KillMode=control-group

# A proxy holds one file descriptor per connection (plus certificates, logs, plugins).
LimitNOFILE=1048576

# --- Hardening. Deliberately conservative: nothing here blocks plugins, ACME, ports 80/443 or
# --- running as root (needed for ports below 1024 and for -plugin_user).
# Gives the service its own /tmp, invisible to other programs.
PrivateTmp=yes
# /usr, /boot and /etc become read-only for the service. Dunree writes only below WorkingDirectory.
# Remove this line if WorkingDirectory is below /etc or /usr.
ProtectSystem=full
# Dunree needs no access to the kernel module loader, kernel logs or to change cgroups.
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
# Blocks creating setuid/setgid files. Plugins started with -plugin_user still work.
RestrictSUIDSGID=yes
# Blocks changing the execution domain (personality). Nothing legitimate here needs it.
LockPersonality=yes
# Not set on purpose, they break common setups:
#   ProtectHome=yes            (breaks an install under /home)
#   NoNewPrivileges=yes        (breaks plugins that rely on sudo or setuid helpers)
#   MemoryDenyWriteExecute=yes (breaks some plugin runtimes)
#   ProtectSystem=strict       (needs a ReadWritePaths= list for conf, plugins, logs, certs)

[Install]
WantedBy=multi-user.target
