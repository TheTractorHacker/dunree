{
  "$comment": "Dunree rebrand policy. Human version: docs/rebrand/plan.md. Rules are applied in order; the first rule whose find matches a span claims it (later rules do not see claimed spans). 'protect' spans are never rewritten by any rule. mode: auto = mechanical replace by tools/rebrand/apply; manual = code change by the named work package (the tool only reports matches); never = must stay (lint fails if changed). Globs are git pathspec globs relative to the repo root.",
  "schema_version": 1,
  "regex_engine": "python re (lookarounds allowed); $1 = group 1; ${VAR} = variables below",
  "variables": {
    "PRODUCT": "Dunree",
    "PRODUCT_LOWER": "dunree",
    "PRODUCT_UPPER": "DUNREE",
    "PRODUCT_DESCRIPTION": "Reverse proxy and web gateway",
    "PUBLISHER": "Foley IT",
    "ORG": "foleyit",
    "REPO": "foleyit/dunree",
    "MODULE_ROOT": "github.com/foleyit/dunree",
    "PRODUCT_VERSION": "1.0.0-beta.1",
    "COMPAT_VERSION": "3.3.6",
    "UPSTREAM_NAME": "Zoraxy",
    "UPSTREAM_AUTHORS": "tobychui and imuslab",
    "UPSTREAM_URL": "https://github.com/tobychui/zoraxy",
    "LEGACY_NAME": "Zoraxy",
    "LEGACY_LOWER": "zoraxy",
    "LEGACY_UPPER": "ZORAXY",
    "LEGACY_MODULE_ROOT": "imuslab.com/zoraxy",
    "SDK_PACKAGE": "dunree_plugin",
    "LEGACY_SDK_PACKAGE": "zoraxy_plugin",
    "PRODUCT_URL": "",
    "PRODUCT_DOMAIN": "dunree.local",
    "DOCS_URL": "",
    "ISSUES_URL": "",
    "STORE_INDEX_URL": "",
    "DOCKER_IMAGE": "foleyit/dunree",
    "CONTAINER_LABEL": "ie.foleyit.dunree.container-identifier",
    "UPDATE_REPO": "TheTractorHacker/zoraxy",
    "LEGACY_SETTING_KEY": "legacy_emit",
    "LEGACY_SETTING_LABEL": "Also send legacy Zoraxy names",
    "LEGACY_REMOVE_IN": "v2"
  },
  "variable_notes": {
    "MODULE_ROOT": "Placeholder; the GitHub org is not decided. Change only here and rerun rule module-path.",
    "UPDATE_REPO": "Deliberately still the current release source until the Dunree repo exists and has releases (plan row 35). Switch to ${REPO} then.",
    "PRODUCT_URL": "Empty = no outbound link (captcha footer, mDNS domain falls back to PRODUCT_DOMAIN).",
    "STORE_INDEX_URL": "Empty = fresh installs contact no plugin store. Existing installs keep their migrated list (plan row 26)."
  },
  "global_exclude": [
    ".git/**",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "NOTICE",
    "third_party/**",
    "CHANGELOG.md",
    "src/mod/plugins/zoraxy_plugin/CHANGELOG.md",
    "docs/triage/**",
    "docs/rebrand/**",
    "tools/rebrand/**",
    "brand/**",
    "**/go.sum",
    "src/mod/plugins/testdata/sdk-1.0.0/**",
    "src/mod/plugins/testdata/sdk-1.1.0/**",
    "src/mod/plugins/testdata/sdk-1.2.0/**",
    "src/mod/plugins/testdata/manifests/installed/**",
    "docs/plugins/conformance-reports/**",
    "src/mod/auth/sso/deprecated/**/README.txt",
    "**/*.png", "**/*.jpg", "**/*.jpeg", "**/*.gif", "**/*.ico", "**/*.webp", "**/*.woff", "**/*.woff2", "**/*.ttf", "**/*.mmdb", "**/*.gz", "**/*.zip"
  ],
  "global_exclude_notes": {
    "src/mod/plugins/testdata/sdk-1.*": "Frozen old-SDK fixtures used to prove backwards compatibility. Never rename.",
    "CHANGELOG.md": "History stays as written; a new Dunree section is added on top by hand.",
    "src/mod/plugins/testdata/manifests/installed/**": "Real third-party manifests used as fixtures."
  },
  "protect": [
    { "id": "attr-copyright", "regex": "Copyright \\(c\\) [0-9-]+(present)? tobychui[^\\n]*" },
    { "id": "attr-author-line", "regex": "(?i)author:\\s*tobychui[^\\n]*" },
    { "id": "attr-added-by", "regex": "Added in Zoraxy v[0-9.]+ by tobychui" },
    { "id": "attr-names", "regex": "\\b(tobychui|imuslab)\\b(?!\\.com/zoraxy)" },
    { "id": "attr-based-on", "regex": "[Bb]ased on Zoraxy[^\\n]*" },
    { "id": "history-issue-links", "regex": "https://github\\.com/tobychui/zoraxy/(issues|pull|commit|commits)[^\\s)\"'<]*" },
    { "id": "history-upstream-refs", "regex": "(tobychui/zoraxy|upstream) ?#[0-9]+" },
    { "id": "frozen-crypto-oauth2", "regex": "zoraxy-oauth2-session-v1" },
    { "id": "frozen-crypto-cluster", "regex": "zoraxy-cluster-v1" },
    { "id": "frozen-crypto-captcha", "regex": "zoraxy-captcha-session-v1\\|" },
    { "id": "frozen-rule-id", "regex": "\"zoraxy-rule:\"" },
    { "id": "frozen-index-format", "regex": "zoraxy-plugin-index" },
    { "id": "frozen-release-header", "regex": "# zoraxy-release " },
    { "id": "legacy-compat-tests", "regex": "[^\\n]*// legacy-compat[^\\n]*" },
    { "id": "neutral-prefixes", "regex": "\\b(zx-[a-z0-9-]+|zxStore|zx_[a-z_]+|zr_[a-z_]+|zorxauth|ZorxAuth)\\b" }
  ],
  "rules": [
    {
      "id": "module-path",
      "class": "R",
      "mode": "auto",
      "find": "imuslab\\.com/zoraxy",
      "replace": "${MODULE_ROOT}",
      "paths": ["**/*.go", "**/go.mod", "tools/nt6.1_go_mod/*", "**/*.md", "**/*.sh", "docker/Dockerfile"],
      "exclude": [],
      "wp": "WP1",
      "test": "go build ./... && go vet ./... in src; TestModuleRootMatchesPolicy"
    },
    {
      "id": "aux-module-paths",
      "class": "R",
      "mode": "auto",
      "find": "^module (aroz\\.org/zoraxy/|zoraxy-)([A-Za-z0-9_-]+)",
      "replace": "module ${MODULE_ROOT}/tools/$2",
      "paths": ["tools/**/go.mod"],
      "wp": "WP1",
      "test": "go build in each tool module"
    },
    {
      "id": "example-module-paths",
      "class": "R",
      "mode": "auto",
      "find": "example\\.com/zoraxy/",
      "replace": "example.com/${PRODUCT_LOWER}/",
      "paths": ["example/**", "docs/plugins/**"],
      "wp": "WP6",
      "test": "example/plugins/build_all.sh"
    },
    {
      "id": "sdk-package",
      "class": "R",
      "mode": "manual",
      "find": "\\bzoraxy_plugin\\b",
      "replace": "${SDK_PACKAGE}",
      "paths": ["src/**", "example/**", "docs/plugins/**", "tools/**"],
      "exclude": ["src/mod/plugins/zoraxy_plugin/**"],
      "wp": "WP5",
      "notes": "Create src/mod/plugins/dunree_plugin; keep src/mod/plugins/zoraxy_plugin as deprecated 1.x copy. Example copies are regenerated by build_all.sh, not sed.",
      "test": "contract tests with testdata/sdk-1.0.0, sdk-1.1.0 and dunree_plugin"
    },
    {
      "id": "plugin-protocol-fields",
      "class": "D+",
      "mode": "manual",
      "find": "\"zoraxy_(port|version|uuid)\"",
      "replace": "\"${PRODUCT_LOWER}_$1\" emitted alongside the legacy field; legacy zoraxy_version carries ${COMPAT_VERSION}",
      "paths": ["src/mod/plugins/**", "src/start.go"],
      "wp": "WP5",
      "test": "ConfigureSpec JSON golden test; old SDK reads port/version"
    },
    {
      "id": "plugin-channel-headers",
      "class": "D+",
      "mode": "manual",
      "find": "X-Zoraxy-(Plugin-Token|RequestID|Requestid|Capture|URI|Uri|Ui-Isolated|Event-Type|Csrf)",
      "replace": "X-${PRODUCT}-$1 (send both always in v1; accept both)",
      "paths": ["src/**"],
      "exclude": ["src/mod/plugins/testdata/**"],
      "wp": "WP5",
      "test": "old-SDK plugin round trip (filter, capture, sniff, UI, events)"
    },
    {
      "id": "cluster-headers",
      "class": "D+",
      "mode": "manual",
      "find": "X-Zoraxy-(Snapshot-Version|Fleet-Hash)",
      "replace": "X-${PRODUCT}-$1 (send both, accept both)",
      "paths": ["src/mod/cluster/**"],
      "wp": "WP3",
      "test": "mixed-version cluster test"
    },
    {
      "id": "public-headers",
      "class": "D",
      "mode": "manual",
      "find": "X-Zoraxy-(Ref|Captcha-Reason|Error-Page|Event|Signature|Timestamp|WAF)\\b",
      "replace": "X-${PRODUCT}-$1; legacy also sent while ${LEGACY_SETTING_KEY}",
      "paths": ["src/**", "docs/**", "contrib/**"],
      "wp": "WP3",
      "test": "header test with setting ON and OFF"
    },
    {
      "id": "internal-context-key",
      "class": "R",
      "mode": "auto",
      "find": "X-Zoraxy-Internal-Ref",
      "replace": "X-${PRODUCT}-Internal-Ref",
      "paths": ["src/**"],
      "wp": "WP3",
      "test": "blockref tests"
    },
    {
      "id": "well-known-paths",
      "class": "D",
      "mode": "manual",
      "find": "/\\.zoraxy/",
      "replace": "/.${PRODUCT_LOWER}/ (legacy path always served in v1, use logged)",
      "paths": ["src/**", "docs/**", "contrib/**", "tools/**"],
      "wp": "WP3",
      "test": "route test both prefixes; custom captcha template posting to legacy path"
    },
    {
      "id": "cookies",
      "class": "D",
      "mode": "manual",
      "find": "\"zoraxy_(csrf|captcha_session|rule_challenge|waf_challenge)\"",
      "replace": "\"${PRODUCT_LOWER}_$1\" (old accepted until expiry, never re-issued)",
      "paths": ["src/**"],
      "wp": "WP2",
      "test": "per-cookie legacy acceptance test"
    },
    {
      "id": "admin-session-cookie",
      "class": "D",
      "mode": "manual",
      "find": "NewAuthenticationAgent\\(SYSTEM_NAME",
      "replace": "NewAuthenticationAgent(ADMIN_SESSION_COOKIE (reads Dunree, falls back to Zoraxy)",
      "paths": ["src/start.go", "src/mod/auth/**"],
      "wp": "WP2",
      "test": "login survives SYSTEM_NAME rename"
    },
    {
      "id": "version-split",
      "class": "R",
      "mode": "manual",
      "find": "SYSTEM_VERSION",
      "replace": "PRODUCT_VERSION (display) or COMPAT_VERSION (conf/version, plugin zoraxy_version, confpack, release upstream=)",
      "paths": ["src/**"],
      "wp": "WP2",
      "test": "conf with version=336 not migrated/rewritten; plugin sees zoraxy_version=3.3.6"
    },
    {
      "id": "metrics",
      "class": "D",
      "mode": "manual",
      "find": "\"zoraxy_(http_|upstream_|waf_|tls_|cluster_|build_info|uptime_|ratelimit_|access_blocked|captcha_(challenges|failed|verified))",
      "replace": "\"${PRODUCT_LOWER}_$1 (legacy family also emitted while ${LEGACY_SETTING_KEY})",
      "paths": ["src/**", "docs/**", "contrib/**"],
      "wp": "WP3",
      "test": "exposition test ON/OFF"
    },
    {
      "id": "env-hook-vars",
      "class": "D",
      "mode": "manual",
      "find": "\\bZORAXY_(EVENT|SOURCE|SUBJECT|DOMAINS|CA|ERROR|TIME|EXPIRY|DAYS_LEFT|EVENT_JSON)\\b",
      "replace": "${PRODUCT_UPPER}_$1 (legacy also set while ${LEGACY_SETTING_KEY})",
      "paths": ["src/**", "docs/**"],
      "wp": "WP3",
      "test": "notify command env test"
    },
    {
      "id": "env-input-vars",
      "class": "D",
      "mode": "manual",
      "find": "\\bZORAXY_(METRICS_TOKEN|RELEASE_KEY|RELEASE_PUB|PLUGIN_INDEX_KEY)\\b",
      "replace": "${PRODUCT_UPPER}_$1 first, then ZORAXY_$1",
      "paths": ["src/**", "tools/**", "docs/**"],
      "wp": "WP3/WP7",
      "test": "env precedence tests"
    },
    {
      "id": "env-test-vars",
      "class": "R",
      "mode": "auto",
      "find": "\\bZORAXY_(BIN|URL|LEAK_SECONDS|TEST_SECRET|TEST_PARENT_SECRET)\\b",
      "replace": "${PRODUCT_UPPER}_$1",
      "paths": ["tools/**", "src/**/*_test.go"],
      "wp": "WP10",
      "test": "suites run"
    },
    {
      "id": "localstorage-keys",
      "class": "D",
      "mode": "manual",
      "find": "(['\"])zoraxy([._])(menu_groups|recent_tabs|pinned_tabs|trafficflow_[a-z]+|status_diagram|sso_tab|site_editor_mode|palette_recent|utm\\.range|topbar\\.update|stats\\.refwhy|lang)\\1",
      "replace": "$1${PRODUCT_LOWER}$2$3$1 (zxStore migrates the old key once)",
      "paths": ["src/web/**"],
      "wp": "WP4",
      "test": "zxStore migration test"
    },
    {
      "id": "csrf-meta",
      "class": "D+",
      "mode": "manual",
      "find": "zoraxy\\.csrf\\.Token",
      "replace": "${PRODUCT_LOWER}.csrf.Token (admin pages render both meta tags; readers try new then old)",
      "paths": ["src/web/**", "src/mod/**", "example/**", "docs/plugins/**"],
      "wp": "WP4/WP5",
      "test": "ui-smoke meta check; old plugin UI"
    },
    {
      "id": "user-agents",
      "class": "D",
      "mode": "manual",
      "find": "\"(Zoraxy|zoraxy)-(HealthCheck|Webhook|Notify|Sablier|HTTPTest|blocklist-import|updater|cluster/|fleet/|wsproxy/|aiassist/|crowdsec-bouncer/)",
      "replace": "\"${PRODUCT}-$2 (old token appended while ${LEGACY_SETTING_KEY})",
      "paths": ["src/**"],
      "wp": "WP3",
      "test": "UA table test"
    },
    {
      "id": "identity-values",
      "class": "D",
      "mode": "manual",
      "find": "\"zoraxy-\"\\+h\\.Parent\\.Option\\.HostUUID|\"zoraxy/\"\\+rrr\\.Version|\"Zoraxy/\"\\+rrr\\.Version|\"zoraxy_sso\"",
      "replace": "see plan rows 12 and 48",
      "paths": ["src/mod/dynamicproxy/**", "src/mod/auth/sso/zorxauth/**"],
      "wp": "WP3",
      "test": "dpcore/zorxauth header tests"
    },
    {
      "id": "crowdsec-scenario",
      "class": "D",
      "mode": "manual",
      "find": "\"zoraxy/manual-ban\"",
      "replace": "\"${PRODUCT_LOWER}/manual-ban\" (list/unban match both)",
      "paths": ["src/mod/crowdsec/**", "contrib/**"],
      "wp": "WP3",
      "test": "crowdsec admin test"
    },
    {
      "id": "mdns",
      "class": "D",
      "mode": "manual",
      "find": "MDNS_(HOSTNAME_PREFIX|IDENTIFY_DOMAIN|IDENTIFY_VENDOR)\\s*=\\s*\"[^\"]*\"",
      "replace": "dunree_ / ${PRODUCT_DOMAIN} / ${PUBLISHER}; zoraxy_<uuid> also registered while ${LEGACY_SETTING_KEY}",
      "paths": ["src/def.go", "src/start.go", "src/mod/mdns/**"],
      "wp": "WP3",
      "test": "mdns register/scan test"
    },
    {
      "id": "release-assets",
      "class": "D",
      "mode": "manual",
      "find": "zoraxy_(\\$\\(os\\)|\\$os|linux|windows|darwin|freebsd|\"\\s*\\+\\s*goos)|zoraxy-pre-update-|zoraxy_file_checksum",
      "replace": "dunree_* primary; zoraxy_* byte-identical copies shipped in v1; readers accept both prefixes",
      "paths": ["src/Makefile", "src/mod/updater/**", "tools/build_release.sh", "tools/sign_release.go"],
      "wp": "WP7",
      "test": "old verify.go fixture accepts Dunree SHA256SUMS; epoch ordering test"
    },
    {
      "id": "store-url",
      "class": "C",
      "mode": "manual",
      "find": "https://raw\\.githubusercontent\\.com/aroz-online/zoraxy-official-plugins[^\"]*",
      "replace": "setting plugin_store_urls (existing installs: migrated as-is; fresh: ${STORE_INDEX_URL})",
      "paths": ["src/start.go", "src/mod/plugins/**"],
      "wp": "WP5",
      "test": "upgrade keeps URL; fresh install makes no request"
    },
    {
      "id": "upstream-site-links",
      "class": "C",
      "mode": "manual",
      "find": "(https?:)?//zoraxy\\.aroz\\.org[^\\s\"'<)]*|https://github\\.com/tobychui/zoraxy(/wiki[^\\s\"'<)]*|/blob/[^\\s\"'<)]*|\\?tab=[^\\s\"'<)]*)?(?=[\\s\"'<)])",
      "replace": "${DOCS_URL} / ${ISSUES_URL} / ${PRODUCT_URL}; history references are protected",
      "paths": ["src/**", "docs/**", "docker/**", "README.md", "DEVELOPMENT.md", "CAPTCHA_FEATURE.md", "ROADMAP.md", "tools/**"],
      "exclude": ["src/mod/plugins/testdata/**"],
      "wp": "WP4/WP9",
      "test": "link grep test with allow-list"
    },
    {
      "id": "example-domain",
      "class": "R",
      "mode": "auto",
      "find": "\\b(s1\\.|www\\.|foo\\.bar\\.|\\*\\.)?aroz\\.org\\b(?!/)",
      "replace": "$1example.com",
      "paths": ["src/web/components/rules.html", "src/web/locales/*.json"],
      "wp": "WP4",
      "test": "i18n key check"
    },
    {
      "id": "cert-org",
      "class": "R",
      "mode": "auto",
      "find": "Organization:\\s*\\[\\]string\\{\"aroz\\.org\"\\}",
      "replace": "Organization: []string{\"${PUBLISHER}\"}",
      "paths": ["src/mod/tlscert/certgen.go"],
      "wp": "WP2",
      "test": "certgen test"
    },
    {
      "id": "docker",
      "class": "R",
      "mode": "manual",
      "find": "zoraxydocker/zoraxy|'zoraxydocker'|com\\.imuslab\\.zoraxy\\.container-identifier|/opt/zoraxy",
      "replace": "${DOCKER_IMAGE} / ${CONTAINER_LABEL} (old label kept in v1) / /opt/${PRODUCT_LOWER} (symlink /opt/zoraxy)",
      "paths": ["docker/**", ".github/workflows/**", "contrib/**", "src/mod/dockerux/**", "docs/**"],
      "wp": "WP8",
      "test": "docker build; entrypoint mount test"
    },
    {
      "id": "systemd",
      "class": "R",
      "mode": "manual",
      "find": "zoraxy\\.service",
      "replace": "${PRODUCT_LOWER}.service (checks accept both; legacy unit file kept with switch notes)",
      "paths": ["docs/deploy/**", "src/start.sh", "src/mod/instance/**", "src/doctor.go", "docs/**"],
      "wp": "WP8",
      "test": "unit lint; start.sh fake-systemctl test"
    },
    {
      "id": "docs-cname",
      "class": "R",
      "mode": "manual",
      "find": "zoraxy\\.aroz\\.org",
      "replace": "delete docs/CNAME",
      "paths": ["docs/CNAME"],
      "wp": "WP9",
      "test": "file absent"
    },
    {
      "id": "codeowners",
      "class": "R",
      "mode": "manual",
      "find": "@tobychui",
      "replace": "@${ORG}/maintainers",
      "paths": ["CODEOWNERS"],
      "wp": "WP8",
      "test": "file lint"
    },
    {
      "id": "file-names",
      "class": "R",
      "mode": "manual",
      "find": "zoraxy",
      "replace": "${PRODUCT_LOWER}",
      "applies_to": "path",
      "paths": ["docs/nginx2zoraxy.html", "docs/deploy/zoraxy.service", "docs/plugins/**/*Zoraxy*", "docs/plugins/**/*zoraxy*", "docs/plugins/gen_zoraxy_plugin_doc.sh"],
      "exclude": ["src/mod/plugins/zoraxy_plugin/**", "src/mod/plugins/testdata/**"],
      "wp": "WP9",
      "notes": "git mv; zoraxy.service is copied, not moved (legacy file stays).",
      "test": "link check"
    },
    {
      "id": "i18n-keys-and-values",
      "class": "R",
      "mode": "manual",
      "find": "Zoraxy",
      "replace": "${PRODUCT}",
      "paths": ["src/web/locales/*.json"],
      "wp": "WP4",
      "notes": "Rewrite keys AND values in every locale in the same commit as the HTML text (keys are the English text). Use tools/i18n, not sed, so key collisions are reported.",
      "test": "tools/i18n key coverage test"
    },
    {
      "id": "text-title-case",
      "class": "R",
      "mode": "auto",
      "find": "\\bZoraxy\\b",
      "replace": "${PRODUCT}",
      "paths": ["src/**", "docs/**", "tools/**", "example/**", "docker/**", "contrib/**", ".github/**", "README.md", "DEVELOPMENT.md", "CAPTCHA_FEATURE.md", "ROADMAP.md"],
      "exclude": ["src/web/locales/**", "src/mod/plugins/zoraxy_plugin/**", "src/mod/plugins/testdata/**", "example/plugins/*/mod/zoraxy_plugin/**"],
      "wp": "WP4/WP9/WP10",
      "notes": "Runs after every specific rule. Protect spans keep attribution ('based on Zoraxy', tobychui lines).",
      "test": "tools/rebrand/check: no unprotected Zoraxy left"
    },
    {
      "id": "text-upper",
      "class": "R",
      "mode": "auto",
      "find": "\\bZORAXY\\b",
      "replace": "${PRODUCT_UPPER}",
      "paths": ["src/**", "docs/**", "tools/**", "README.md"],
      "wp": "WP9",
      "test": "tools/rebrand/check"
    },
    {
      "id": "text-lower",
      "class": "R",
      "mode": "manual",
      "find": "\\bzoraxy\\b",
      "replace": "${PRODUCT_LOWER}",
      "paths": ["src/**", "docs/**", "tools/**", "example/**", "docker/**", "contrib/**", ".github/**", "README.md", "DEVELOPMENT.md"],
      "exclude": ["src/mod/plugins/testdata/**"],
      "wp": "WP4/WP8/WP9/WP10",
      "notes": "Manual review: lowercase hits are mostly binary names, paths and wire values already handled above. The tool lists what is left; nothing is rewritten blindly.",
      "test": "tools/rebrand/check"
    }
  ],
  "legacy_setting": {
    "key": "legacy_emit",
    "label": "Also send legacy Zoraxy names",
    "default": true,
    "remove_in": "v2",
    "controls": ["public-headers", "metrics", "env-hook-vars", "user-agents", "identity-values", "mdns"],
    "does_not_control_in_v1": ["plugin-channel-headers", "plugin-protocol-fields", "csrf-meta", "cluster-headers", "well-known-paths"],
    "always_accepted_on_input": ["plugin-channel-headers", "cluster-headers", "well-known-paths", "cookies", "admin-session-cookie", "env-input-vars", "localstorage-keys", "crowdsec-scenario", "release-assets", "frozen-index-format", "frozen-release-header"]
  },
  "frozen": [
    { "string": "zoraxy-oauth2-session-v1", "where": "src/mod/auth/sso/oauth2/{persist,session}.go", "why": "HKDF salt; change = all OAuth2 sessions and persisted session data unreadable" },
    { "string": "zoraxy-cluster-v1", "where": "src/mod/cluster/keys.go", "why": "HKDF salt; change = followers cannot decrypt the primary's snapshots" },
    { "string": "zoraxy-captcha-session-v1|", "where": "src/mod/dynamicproxy/captcha/captcha.go", "why": "session token derivation; change = every visitor re-challenged" },
    { "string": "zoraxy-rule:", "where": "src/mod/plugins/ruleinfo.go", "why": "stable rule IDs derived from it" },
    { "string": "zoraxy-plugin-index", "where": "src/mod/plugins/store_verify.go, tools/plugin-index", "why": "signed index format id; accepted forever, dunree-plugin-index added" },
