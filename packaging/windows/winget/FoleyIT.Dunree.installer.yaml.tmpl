# winget installer manifest template. packaging/windows/winget/render.sh fills in ${...}.
# The installers are the Inno Setup files built from packaging/windows/dunree.iss.
# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.1.6.0.schema.json
PackageIdentifier: FoleyIT.Dunree
PackageVersion: ${VERSION}
InstallerType: inno
Scope: machine
InstallModes:
  - interactive
  - silent
  - silentWithProgress
UpgradeBehavior: install
ElevationRequirement: elevatedOnly
MinimumOSVersion: 10.0.0.0
Installers:
  - Architecture: x64
    InstallerUrl: ${BASE_URL}/dunree_${VERSION}_windows_amd64_setup.exe
    InstallerSha256: ${SHA256_AMD64}
  - Architecture: arm64
    InstallerUrl: ${BASE_URL}/dunree_${VERSION}_windows_arm64_setup.exe
    InstallerSha256: ${SHA256_ARM64}
ManifestType: installer
ManifestVersion: 1.6.0
