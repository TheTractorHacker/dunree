# Generated by Dunree 1.0.0-test for member "node-a" (192.0.2.11). Settings fingerprint: 232a851c
# Do not edit by hand: change the Floating IP settings in Dunree and generate again.
global_defs {
    enable_script_security
    script_user keepalived_script
    vrrp_garp_master_refresh 0
}

vrrp_script chk_dunree {
    script "/usr/bin/curl -fsS --max-time 2 -o /dev/null http://127.0.0.1:8081/.dunree/health"
    interval 2
    timeout 3
    fall 3
    rise 2
    init_fail
}

vrrp_instance VI_DUNREE {
    state BACKUP
    interface ens18
    virtual_router_id 51
    priority 150
    advert_int 1
    preempt_delay 60
    virtual_ipaddress {
        192.0.2.10/24 dev ens18
    }
    track_script {
        chk_dunree
    }
}
